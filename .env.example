# Public hostname Caddy serves on. SSL is provisioned automatically for this.
HOSTNAME=postal-logs.example.com

# Email Caddy uses for Let's Encrypt ACME account.
ACME_EMAIL=ops@example.com

# Generate with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-hex-string

# Google OAuth 2.0 credentials (Google Cloud Console → APIs & Services →
# Credentials → Create OAuth client ID → Web application).
# Authorized redirect URI:  https://${HOSTNAME}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Restrict logins to this Google Workspace domain. Leave empty to allow any
# pre-invited user.
ALLOWED_DOMAIN=colada.ag

# The first user to sign in with this email becomes the initial admin and
# can then invite others through the UI. Safe to leave set after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=

# Retention (days). Raw event rows older than RETAIN_RAW_DAYS are deleted
# by the nightly job. Stats and suppression are kept forever.
RETAIN_RAW_DAYS=120
SHOW_RAW_DAYS=90

# Node env
NODE_ENV=production
PORT=3000

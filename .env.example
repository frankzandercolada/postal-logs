# Public hostname Caddy serves on. SSL is provisioned automatically for this.
HOSTNAME=postal-logs.example.com

# Email Caddy uses for Let's Encrypt ACME account.
ACME_EMAIL=ops@example.com

# Generate with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-hex-string

# Bootstrap admin. On first boot (when there are no users in the DB yet),
# the app seeds this email as an internal-staff admin with the password
# below. After bootstrap you can remove BOOTSTRAP_ADMIN_PASSWORD from
# this file. Min 12 chars.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Retention (days). Raw event rows older than RETAIN_RAW_DAYS are deleted
# by the nightly job. Stats and suppression are kept forever.
RETAIN_RAW_DAYS=120
SHOW_RAW_DAYS=90

# Node env
NODE_ENV=production
PORT=3000
